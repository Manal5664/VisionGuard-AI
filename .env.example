# Local PostgreSQL example. Keep real credentials in .env or the hosting provider.
DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@localhost:5432/visionguard
# Neon example (copy the real direct URL from Neon; never commit it):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# Comma-separated exact browser origins. Render should use the final Vercel origin.
VISIONGUARD_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# VISIONGUARD_FRONTEND_ORIGINS=https://visionguard.vercel.app
